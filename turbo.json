{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "deploy": {
      "dependsOn": ["web#build"],
      "inputs": ["scripts/**", "build/**"],
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["!scripts/**", "$TURBO_DEFAULT$", ".env*"],
      "outputs": [".svelte-kit/**", ".vercel/**", "build/**"],
      "outputLogs": "new-only"
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
